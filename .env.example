# Docker
IMAGE_TAG=image_tag_hash

# Nginx
LE_EMAIL=your.letsencrypt@email.com
SSL_CERT=/certs/fullchain.pem
SSL_KEY=/certs/privkey.pem
VPN_BIND_ADDRESS=127.0.0.1

# Owner
OWNER_INIT_LOGIN=owner
OWNER_INIT_PASSWORD=owner

# App
APP_URL_SCHEMA=https
APP_DEBUG=true
APP_SECRET_KEY=SECRET_KEY
APP_DOMAIN=localhost
APP_USE_CACHE=true
APP_CONTACT_REQUESTS_ENABLED=false

# I18n
I18N_DEFAULT_LANGUAGE=ru

# Competency Matrix
COMPETENCY_MATRIX_QUESTION_SUGGESTION_ANONYMOUS_DAILY_LIMIT=10
AGENT_ACCESS_ISSUING_CERTIFICATE_FILE=/run/secrets/agent_issuing_certificate
AGENT_ACCESS_ISSUING_PRIVATE_KEY_FILE=/run/secrets/agent_issuing_private_key
AGENT_ACCESS_CERTIFICATE_CHAIN_FILE=/run/secrets/agent_certificate_chain
AGENT_ACCESS_ISSUING_CERTIFICATE="-----BEGIN CERTIFICATE-----\n(agent issuing certificate)\n-----END CERTIFICATE-----"
AGENT_ACCESS_ISSUING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n(agent issuing private key)\n-----END PRIVATE KEY-----"
AGENT_ACCESS_CERTIFICATE_CHAIN="-----BEGIN CERTIFICATE-----\n(agent issuing certificate)\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n(agent root certificate)\n-----END CERTIFICATE-----"

# TaskIQ
TASKIQ_AUTH_SESSION_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_AGENT_AUDIT_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_CACHE_WARM_INTERVAL_SECONDS=3600
TASKIQ_FILE_ORPHAN_PRUNE_INTERVAL_SECONDS=86400
TASKIQ_RESULT_EXPIRE_SECONDS=3600

# Files
FILES_ORPHAN_RETENTION_SECONDS=604800

# Cache warm
CACHE_WARM_ARTICLES_PAGE_SIZE=10

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_DRIVER=postgresql+psycopg
DB_HOST=postgres
DB_PORT=5432
DB_NAME=competency_trainer_database
DB_POOL_PRE_PING=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_EXPIRE_ON_COMMIT=false
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Auth
AUTH_TOKEN_EXPIRE_SECONDS=900
AUTH_SESSION_EXPIRE_SECONDS=2592000
AUTH_SESSION_ABSOLUTE_EXPIRE_SECONDS=2592000
AUTH_TOKEN_HEADER_NAME=Authorization
AUTH_TOKEN_PREFIX=Bearer
AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n(base64 content)\n-----END PUBLIC KEY-----"
AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n(base64 content)\n-----END PRIVATE KEY-----"

# Minio
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_SECRET_KEY=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECURE=false
MINIO_PUBLIC_URL=https://s3.localhost
MINIO_CORS_MAX_AGE_SECONDS=300

# Sentry
SENTRY_USE=true
SENTRY_DSN=https://some.sentry.io/some_id

# Cache
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Query-plan reports (relative to backend/)
PERFORMANCE_REPORT_DIR=performance/reports
